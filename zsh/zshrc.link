# ~/.zshrc — managed by ~/.dotfiles (symlinked). Cross-platform (macOS + Ubuntu).

# --- Powerlevel10k instant prompt (must stay near the top) -----------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- history ---------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_reduce_blanks hist_verify
HIST_STAMPS="yyyy-mm-dd"

# --- completion system (must init before plugins that call compdef) --------
autoload -Uz compinit
compinit -C            # -C: skip the slow daily security check (fast startup)

# --- antidote plugin manager (loads plugins from ~/.zsh_plugins.txt) --------
# powerlevel10k itself is loaded as a plugin from that file.
_antidote=""
for _cand in \
  "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh" \
  /usr/local/opt/antidote/share/antidote/antidote.zsh \
  "$HOME/.antidote/antidote.zsh"; do
  if [[ -r "$_cand" ]]; then _antidote="$_cand"; break; fi
done
if [[ -n "$_antidote" ]]; then
  source "$_antidote"
  antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
fi
unset _antidote _cand

# --- p10k prompt config (run `p10k configure` to (re)generate ~/.p10k.zsh) --
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# --- personal + work shell config ------------------------------------------
[[ -f ~/.dannyrc ]]  && source ~/.dannyrc
